# 端口号
VITE_PORT=5777

VITE_BASE=/

# 接口地址
# 同源部署，不跨域（SPEC §12.4）
VITE_GLOB_API_URL=/console/v1

# 是否开启 Nitro Mock服务，true 为开启，false 为关闭
# 已关闭：本项目有真实后端，Nitro mock 只会掩盖前后端契约不一致（SPEC §12.2）
VITE_NITRO_MOCK=false

# 是否打开 devtools，true 为打开，false 为关闭
VITE_DEVTOOLS=false

# 是否注入全局loading
VITE_INJECT_APP_LOADING=true
