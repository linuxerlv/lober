VITE_BASE=/

# 接口地址
# 同源部署，不跨域，也不需要 _app-config-*.js 那套打包后改接口地址的机制（SPEC §12.4）
VITE_GLOB_API_URL=/console/v1

# 是否开启压缩，可以设置为 none, brotli, gzip
# 内嵌的 http.FS 不会自动发 .gz，压缩交给 nginx 现场做
VITE_COMPRESS=none

# 是否开启 PWA
VITE_PWA=false

# vue-router 的模式
# hash 路由不需要 SPA fallback，Go 的静态 handler 与 nginx 都不必配 history rewrite
VITE_ROUTER_HISTORY=hash

# 是否注入全局loading
VITE_INJECT_APP_LOADING=true

# 打包后是否生成dist.zip
# 不需要 dist.zip
VITE_ARCHIVER=false

# 是否开启 Nitro Mock 服务
# 已关闭：本项目有真实后端，Nitro mock 只会掩盖前后端契约不一致（SPEC §12.2）
VITE_NITRO_MOCK=false

# 是否打开 devtools
VITE_DEVTOOLS=false
