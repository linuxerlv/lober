{
  "Hooks": [
    {
      "ID": "builtin-network",
      "Version": 2,
      "Name": "lober:network",
      "Description": "DHCP network and host naming. Interface names must match the selected target.",
      "State": "approved",
      "Author": "",
      "Approver": "",
      "Builtin": true,
      "Params": [
        {
          "Name": "hostname",
          "Label": "",
          "Type": "hostname",
          "List": false,
          "Required": false,
          "Default": "lober-node",
          "Options": null,
          "Min": null,
          "Max": null,
          "Offer": ""
        },
        {
          "Name": "interface",
          "Label": "",
          "Type": "word",
          "List": false,
          "Required": false,
          "Default": "eth0",
          "Options": null,
          "Min": null,
          "Max": null,
          "Offer": ""
        }
      ],
      "TimeoutSec": 300,
      "Required": true,
      "Impls": [
        {
          "Family": "linux",
          "Series": [
            "rhel",
            "rocky",
            "almalinux",
            "openeuler",
            "opencloudos"
          ],
          "Kind": "fragment",
          "Body": "network --bootproto=dhcp --device=link --activate --hostname='{{param:hostname}}'\n",
          "Interpreter": "",
          "Timings": null
        },
        {
          "Family": "linux",
          "Series": [
            "debian"
          ],
          "Kind": "script",
          "Body": "#!/bin/sh\nset -eu\n: \"${LOBER_PARAM_HOSTNAME:?hostname required}\"\n# A network-loaded preseed arrives after netcfg. Apply the requested name in\n# the installed system, after the installer has finished copying its network.\nprintf '%s\\n' \"$LOBER_PARAM_HOSTNAME\" > /etc/hostname\nhostname \"$LOBER_PARAM_HOSTNAME\"\nhosts=$(mktemp /etc/hosts.lober.XXXXXX)\ntrap 'rm -f \"$hosts\"' EXIT HUP INT TERM\nawk '$1 != \"127.0.1.1\" { print }' /etc/hosts > \"$hosts\"\nprintf '127.0.1.1 %s' \"$LOBER_PARAM_HOSTNAME\" >> \"$hosts\"\nshort=${LOBER_PARAM_HOSTNAME%%.*}\nif [ \"$short\" != \"$LOBER_PARAM_HOSTNAME\" ]; then\n    printf ' %s' \"$short\" >> \"$hosts\"\nfi\nprintf '\\n' >> \"$hosts\"\nchmod 644 \"$hosts\"\nmv \"$hosts\" /etc/hosts\n",
          "Interpreter": "sh",
          "Timings": [
            "firstboot"
          ]
        },
        {
          "Family": "linux",
          "Series": [
            "ubuntu"
          ],
          "Kind": "fragment",
          "Body": "network:\n  version: 2\n  ethernets:\n    lober:\n      match:\n        name: '{{param:interface}}'\n      dhcp4: true\n",
          "Interpreter": "",
          "Timings": null
        },
        {
          "Family": "linux",
          "Series": [
            "sles15",
            "leap15"
          ],
          "Kind": "fragment",
          "Body": "<networking>\n  <keep_install_network config:type=\"boolean\">false</keep_install_network>\n  <dns><hostname>{{param:hostname}}</hostname><dhcp_hostname config:type=\"boolean\">false</dhcp_hostname></dns>\n  <interfaces config:type=\"list\">\n    <interface><device>{{param:interface}}</device><bootproto>dhcp</bootproto><startmode>auto</startmode></interface>\n  </interfaces>\n</networking>\n",
          "Interpreter": "",
          "Timings": null
        },
        {
          "Family": "linux",
          "Series": [
            "sles16",
            "leap16"
          ],
          "Kind": "fragment",
          "Body": "hostname: { static: '{{param:hostname}}' },\nnetwork: {\n  connections: [{ id: 'lober', interface: '{{param:interface}}', method4: 'auto' }],\n},\n",
          "Interpreter": "",
          "Timings": null
        },
        {
          "Family": "windows",
          "Series": [
            "windows-server"
          ],
          "Kind": "fragment",
          "Body": "<ComputerName>{{param:hostname}}</ComputerName>\n",
          "Interpreter": "",
          "Timings": null
        },
        {
          "Family": "esxi",
          "Series": [
            "esxi"
          ],
          "Kind": "fragment",
          "Body": "network --bootproto=dhcp --device='{{param:interface}}' --hostname='{{param:hostname}}'\n",
          "Interpreter": "",
          "Timings": null
        }
      ],
      "Rev": 0
    },
    {
      "ID": "builtin-sshkey",
      "Version": 2,
      "Name": "lober:sshkey",
      "Description": "SSH public key access. Match username to the account hook. Windows requires OpenSSH Server; only Server 2025 is guaranteed by the content contract.",
      "State": "approved",
      "Author": "",
      "Approver": "",
      "Builtin": true,
      "Params": [
        {
          "Name": "username",
          "Label": "",
          "Type": "word",
          "List": false,
          "Required": true,
          "Default": "lober",
          "Options": null,
          "Min": null,
          "Max": null,
          "Offer": ""
        },
        {
          "Name": "key",
          "Label": "",
          "Type": "sshkey",
          "List": false,
          "Required": true,
          "Default": "",
          "Options": null,
          "Min": null,
          "Max": null,
          "Offer": ""
        }
      ],
      "TimeoutSec": 300,
      "Required": true,
      "Impls": [
        {
          "Family": "linux",
          "Series": [
            "rhel",
            "rocky",
            "almalinux",
            "openeuler",
            "opencloudos"
          ],
          "Kind": "fragment",
          "Body": "sshkey --username='{{param:username}}' '{{param:key}}'\n",
          "Interpreter": "",
          "Timings": null
        },
        {
          "Family": "linux",
          "Series": [
            "debian"
          ],
          "Kind": "script",
          "Body": "#!/bin/sh\nset -eu\n: \"${LOBER_PARAM_USERNAME:?username required}\"\n: \"${LOBER_PARAM_KEY:?SSH key required}\"\nentry=$(getent passwd \"$LOBER_PARAM_USERNAME\") || exit 67\nIFS=: read -r name password uid gid gecos home shell <<EOF\n$entry\nEOF\n[ \"$name\" = \"$LOBER_PARAM_USERNAME\" ] || exit 67\ncase \"$home\" in /*) ;; *) exit 67;; esac\numask 077\ninstall -d -m 700 -o \"$uid\" -g \"$gid\" -- \"$home/.ssh\"\nprintf '%s\\n' \"$LOBER_PARAM_KEY\" >> \"$home/.ssh/authorized_keys\"\nchown \"$uid:$gid\" -- \"$home/.ssh/authorized_keys\"\nchmod 600 -- \"$home/.ssh/authorized_keys\"\nif command -v restorecon >/dev/null 2>&1; then restorecon -R -- \"$home/.ssh\"; fi\n",
          "Interpreter": "sh",
          "Timings": [
            "firstboot"
          ]
        },
        {
          "Family": "linux",
          "Series": [
            "ubuntu"
          ],
          "Kind": "fragment",
          "Body": "ssh:\n  install-server: true\n  allow-pw: false\n  authorized-keys:\n    - '{{param:key}}'\n",
          "Interpreter": "",
          "Timings": null
        },
        {
          "Family": "linux",
          "Series": [
            "sles15",
            "leap15"
          ],
          "Kind": "fragment",
          "Body": "<authorized_keys config:type=\"list\">\n  <listentry>{{param:key}}</listentry>\n</authorized_keys>\n",
          "Interpreter": "",
          "Timings": null
        },
        {
          "Family": "linux",
          "Series": [
            "sles16",
            "leap16"
          ],
          "Kind": "script",
          "Body": "#!/bin/sh\nset -eu\n: \"${LOBER_PARAM_USERNAME:?username required}\"\n: \"${LOBER_PARAM_KEY:?SSH key required}\"\nentry=$(getent passwd \"$LOBER_PARAM_USERNAME\") || exit 67\nIFS=: read -r name password uid gid gecos home shell <<EOF\n$entry\nEOF\n[ \"$name\" = \"$LOBER_PARAM_USERNAME\" ] || exit 67\ncase \"$home\" in /*) ;; *) exit 67;; esac\numask 077\ninstall -d -m 700 -o \"$uid\" -g \"$gid\" -- \"$home/.ssh\"\nprintf '%s\\n' \"$LOBER_PARAM_KEY\" >> \"$home/.ssh/authorized_keys\"\nchown \"$uid:$gid\" -- \"$home/.ssh/authorized_keys\"\nchmod 600 -- \"$home/.ssh/authorized_keys\"\nif command -v restorecon >/dev/null 2>&1; then restorecon -R -- \"$home/.ssh\"; fi\n",
          "Interpreter": "sh",
          "Timings": [
            "firstboot"
          ]
        },
        {
          "Family": "windows",
          "Series": [
            "windows-server"
          ],
          "Kind": "script",
          "Body": "$ErrorActionPreference = 'Stop'\n$capability = Get-WindowsCapability -Online -Name 'OpenSSH.Server*' | Select-Object -First 1\nif (-not $capability) { throw 'OpenSSH Server capability unavailable; qualify the target image' }\nif ($capability.State -ne 'Installed') { Add-WindowsCapability -Online -Name $capability.Name -ErrorAction Stop | Out-Null }\n$account = Get-LocalUser -Name $env:LOBER_PARAM_USERNAME -ErrorAction Stop\n$admins = Get-LocalGroup -SID 'S-1-5-32-544'\n$member = Get-LocalGroupMember -Group $admins | Where-Object { $_.SID -eq $account.SID }\nif (-not $member) { throw 'This builtin SSH hook requires the administrator account created by the account hook' }\n$directory = Join-Path $env:ProgramData 'ssh'\nNew-Item -ItemType Directory -Force -Path $directory | Out-Null\n$path = Join-Path $directory 'administrators_authorized_keys'\n[IO.File]::AppendAllText($path, $env:LOBER_PARAM_KEY + \"`n\", (New-Object Text.UTF8Encoding($false)))\n$acl = New-Object Security.AccessControl.FileSecurity\n$acl.SetAccessRuleProtection($true, $false)\nforeach ($sid in @('S-1-5-18', 'S-1-5-32-544')) {\n  $identity = New-Object Security.Principal.SecurityIdentifier($sid)\n  $rule = New-Object Security.AccessControl.FileSystemAccessRule($identity, 'FullControl', 'Allow')\n  $acl.AddAccessRule($rule)\n}\nSet-Acl -LiteralPath $path -AclObject $acl\nSet-Service -Name sshd -StartupType Automatic\nStart-Service sshd\nif (-not (Get-NetFirewallRule -Name 'OpenSSH-Server-In-TCP' -ErrorAction SilentlyContinue)) {\n  New-NetFirewallRule -Name 'OpenSSH-Server-In-TCP' -DisplayName 'OpenSSH Server' -Enabled True -Direction Inbound -Protocol TCP -Action Allow -LocalPort 22 | Out-Null\n}\n",
          "Interpreter": "powershell",
          "Timings": [
            "firstboot"
          ]
        },
        {
          "Family": "esxi",
          "Series": [
            "esxi"
          ],
          "Kind": "script",
          "Body": "#!/bin/sh\nset -eu\n: \"${LOBER_PARAM_KEY:?SSH key required}\"\n[ \"$LOBER_PARAM_USERNAME\" = root ] || exit 64\numask 077\nmkdir -p /etc/ssh/keys-root\nprintf '%s\\n' \"$LOBER_PARAM_KEY\" >> /etc/ssh/keys-root/authorized_keys\nchmod 600 /etc/ssh/keys-root/authorized_keys\nvim-cmd hostsvc/enable_ssh\nvim-cmd hostsvc/start_ssh\n/sbin/auto-backup.sh\n",
          "Interpreter": "sh",
          "Timings": [
            "firstboot"
          ]
        }
      ],
      "Rev": 0
    }
  ],
