      "Body": "<?xml version=\"1.0\" encoding=\"utf-8\"?>\n<unattend xmlns=\"urn:schemas-microsoft-com:unattend\" xmlns:wcm=\"http://schemas.microsoft.com/WMIConfig/2002/State\">\n  <!-- Edition is the actual media image index. AutoLogon is required for the ordered firstboot chain. -->\n  <!-- Server 2016/2019 static profiles require a separately qualified runtime; current UTF8 helper ABI does not qualify them. -->\n  <settings pass=\"windowsPE\">\n    <component name=\"Microsoft-Windows-International-Core-WinPE\" processorArchitecture=\"amd64\" publicKeyToken=\"31bf3856ad364e35\" language=\"neutral\" versionScope=\"nonSxS\">\n      <SetupUILanguage><UILanguage>en-US</UILanguage></SetupUILanguage><InputLocale>en-US</InputLocale><SystemLocale>en-US</SystemLocale><UILanguage>en-US</UILanguage><UserLocale>en-US</UserLocale>\n    </component>\n    <component name=\"Microsoft-Windows-Setup\" processorArchitecture=\"amd64\" publicKeyToken=\"31bf3856ad364e35\" language=\"neutral\" versionScope=\"nonSxS\">\n      <UserData><AcceptEula>true</AcceptEula></UserData>\n      <RunSynchronous>\n        <RunSynchronousCommand wcm:action=\"add\"><Order>1</Order><Path>{{slot:partition@pre}}</Path></RunSynchronousCommand>\n      </RunSynchronous>\n      <ImageInstall><OSImage>\n        <InstallFrom><MetaData wcm:action=\"add\"><Key>/IMAGE/INDEX</Key><Value>{{param:edition}}</Value></MetaData></InstallFrom>\n        <InstallTo><DiskID>{{param:disk_index}}</DiskID><PartitionID>3</PartitionID></InstallTo>\n        <WillShowUI>OnError</WillShowUI>\n      </OSImage></ImageInstall>\n    </component>\n  </settings>\n  <settings pass=\"specialize\">\n    <component name=\"Microsoft-Windows-Shell-Setup\" processorArchitecture=\"amd64\" publicKeyToken=\"31bf3856ad364e35\" language=\"neutral\" versionScope=\"nonSxS\">\n      {{slot:network}}\n      <TimeZone>UTC</TimeZone>\n    </component>\n  </settings>\n  <settings pass=\"oobeSystem\">\n    <component name=\"Microsoft-Windows-Shell-Setup\" processorArchitecture=\"amd64\" publicKeyToken=\"31bf3856ad364e35\" language=\"neutral\" versionScope=\"nonSxS\">\n      {{slot:account}}\n      <OOBE><HideEULAPage>true</HideEULAPage><HideOnlineAccountScreens>true</HideOnlineAccountScreens><ProtectYourPC>3</ProtectYourPC></OOBE>\n      <FirstLogonCommands>\n        <SynchronousCommand wcm:action=\"add\">\n          <Order>1</Order>\n          <CommandLine>cmd /d /c {{lober:firstboot}} &amp;&amp; {{slot:configure@firstboot}} &amp;&amp; {{lober:cleanup}}</CommandLine>\n          <Description>Lober ordered first boot</Description>\n        </SynchronousCommand>\n      </FirstLogonCommands>\n    </component>\n  </settings>\n</unattend>\n",
