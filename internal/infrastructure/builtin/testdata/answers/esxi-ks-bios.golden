vmaccepteula
rootpw --iscrypted '$6$fixture$notARealPasswordHash'
install --firstdisk='local' --overwritevmfs
network --bootproto=dhcp --device='vmnic0' --hostname='lober-node'
reboot
# Secure Boot disables native firstboot. Layer7 must reject it and qualify the ESXi 8/9 ABI.
%firstboot --interpreter=busybox
set -e
LOBER_ESXI_NATIVE_SCRIPT=$0;LOBER_ESXI_OWNER=lober-esxi-firstboot-task-9;export LOBER_ESXI_NATIVE_SCRIPT LOBER_ESXI_OWNER;(LOBER_OLD_IFS=${IFS-};case ${IFS+x} in x) LOBER_IFS_SET=1;; *) LOBER_IFS_SET=0;; esac;case $- in *f*) LOBER_OLD_GLOB=1;; *) LOBER_OLD_GLOB=0;; esac;IFS=;set -f;LOBER_ESXI_CODE=$(echo  | openssl base64 -d -A)||exit 127;LOBER_ESXI_HASH=$(printf %s $LOBER_ESXI_CODE | sha256sum)||exit 127;case $LOBER_ESXI_HASH in 524a4f6cab56bb93cb18a9044f199f78e28374e7e216f8f1398da3a5e1a499ee*) :;; *) exit 65;; esac;eval $LOBER_ESXI_CODE)
(LOBER_OLD_IFS=${IFS-};case ${IFS+x} in x) LOBER_IFS_SET=1;; *) LOBER_IFS_SET=0;; esac;case $- in *f*) LOBER_OLD_GLOB=1;; *) LOBER_OLD_GLOB=0;; esac;IFS=;set -f;LOBER_ESXI_CODE=$(echo  | openssl base64 -d -A)||exit 127;LOBER_ESXI_HASH=$(printf %s $LOBER_ESXI_CODE | sha256sum)||exit 127;case $LOBER_ESXI_HASH in 789cc56d18ca0b6d4b22dfeb292c93a779db90877cc0a31b8907e1a13b5a6c5d*) :;; *) exit 65;; esac;eval $LOBER_ESXI_CODE)
(LOBER_OLD_IFS=${IFS-};case ${IFS+x} in x) LOBER_IFS_SET=1;; *) LOBER_IFS_SET=0;; esac;case $- in *f*) LOBER_OLD_GLOB=1;; *) LOBER_OLD_GLOB=0;; esac;IFS=;set -f;LOBER_ESXI_CODE=$(echo  | openssl base64 -d -A)||exit 127;LOBER_ESXI_HASH=$(printf %s $LOBER_ESXI_CODE | sha256sum)||exit 127;case $LOBER_ESXI_HASH in 4ad7bece045367168dfaaec1a7d5f4bb4828873c37f50c6907c3f665b7524a71*) :;; *) exit 65;; esac;eval $LOBER_ESXI_CODE)
