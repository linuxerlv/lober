vmaccepteula
rootpw --iscrypted '$6$fixture$notARealPasswordHash'
install --firstdisk='local' --overwritevmfs
network --bootproto=dhcp --device='vmnic0' --hostname='lober-node'
reboot
# Secure Boot disables native firstboot. Layer7 must reject it and qualify the ESXi 8/9 ABI.
%pre --interpreter=busybox
set -eu
umask 077
D='/tmp/lober-esxi-e34d3152baeb112c9bd77f2381ea0cf9b902613c95d5ae2660b51a4e7ede2785'
[ ! -e "$D" ] && [ ! -L "$D" ] || exit 66
mkdir -m 700 "$D"
trap 's=$?; if [ "$s" -ne 0 ]; then rm -f "$D/stage.sh"; rmdir "$D" 2>/dev/null || :; fi' EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM
timeout -t 30 wget -q -O "$D/stage.sh" 'http://gw.example.test/v1/answer/task-9/boot-fixture/esxi-firstboot.sh'
LOBER_HASH=$(sha256sum "$D/stage.sh") || exit 127
case $LOBER_HASH in 28fb9ff6e4e3f4b43e2e6f765a24769b7086c25c26109c0c815d1e296802ff22\ *) :;; *) exit 65;; esac
trap - EXIT HUP INT TERM
%post --interpreter=busybox
set -eu
umask 077
D='/tmp/lober-esxi-e34d3152baeb112c9bd77f2381ea0cf9b902613c95d5ae2660b51a4e7ede2785'
[ -d "$D" ] && [ ! -L "$D" ] && [ -f "$D/stage.sh" ] && [ ! -L "$D/stage.sh" ] || exit 66
[ "$(stat -c %u:%a "$D")" = 0:700 ] && [ "$(stat -c %u:%a "$D/stage.sh")" = 0:600 ] || exit 66
TARGET=
CREATED=0
trap 's=$?; if [ "$s" -ne 0 ]; then if [ "$CREATED" -eq 1 ]; then rm -f "$TARGET/stage.sh" || :; rmdir "$TARGET" 2>/dev/null || :; fi; rm -f "$D/stage.sh" || :; rmdir "$D" 2>/dev/null || :; fi' EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM
LOBER_DEVICES=$(esxcli storage core device list) || exit 66
LOBER_DISKS=$(printf '%s\n' "$LOBER_DEVICES" | awk '/^[[:space:]]*Device Type:[[:space:]]*Direct-Access[[:space:]]*$/ { n++ } END { print n+0 }') || exit 66
[ "$LOBER_DISKS" -eq 1 ] || exit 66
COUNT=0
VOLUME=
for CANDIDATE in /vmfs/volumes/OSDATA-*; do
 [ -d "$CANDIDATE" ] || continue
 COUNT=$((COUNT + 1))
 VOLUME=$CANDIDATE
done
[ "$COUNT" -eq 1 ] && [ "$(stat -f -c %T "$VOLUME")" = vmfs6l ] || exit 66
TARGET="$VOLUME/lober-esxi-e34d3152baeb112c9bd77f2381ea0cf9b902613c95d5ae2660b51a4e7ede2785"
[ ! -e "$TARGET" ] && [ ! -L "$TARGET" ] || exit 66
mkdir -m 700 "$TARGET"
CREATED=1
cp "$D/stage.sh" "$TARGET/stage.sh"
chmod 600 "$TARGET/stage.sh"
LOBER_HASH=$(sha256sum "$TARGET/stage.sh") || exit 127
case $LOBER_HASH in 28fb9ff6e4e3f4b43e2e6f765a24769b7086c25c26109c0c815d1e296802ff22\ *) :;; *) exit 65;; esac
rm -f "$D/stage.sh"
rmdir "$D"
trap - EXIT HUP INT TERM
%firstboot --interpreter=busybox
LOBER_ESXI_RUN_ID=$$
export LOBER_ESXI_RUN_ID
LOBER_ESXI_CHILD=
LOBER_ESXI_DONE=0
lober_esxi_cleanup() {
 if [ -d /tmp/lober ] && [ ! -L /tmp/lober ] && [ "$(stat -c %u:%a /tmp/lober)" = 0:700 ] && [ -f /tmp/lober/.owner ] && [ ! -L /tmp/lober/.owner ] && [ "$(cat /tmp/lober/.owner)" = 'lober-esxi-firstboot-task-9'":$LOBER_ESXI_RUN_ID" ]; then
  if [ ! -L '/scratch/lober-esxi-e34d3152baeb112c9bd77f2381ea0cf9b902613c95d5ae2660b51a4e7ede2785' ] && [ -f '/scratch/lober-esxi-e34d3152baeb112c9bd77f2381ea0cf9b902613c95d5ae2660b51a4e7ede2785/stage.sh' ] && [ ! -L '/scratch/lober-esxi-e34d3152baeb112c9bd77f2381ea0cf9b902613c95d5ae2660b51a4e7ede2785/stage.sh' ] && [ "$(stat -f -c %T /scratch)" = vmfs6l ] && [ "$(stat -c %u:%a '/scratch/lober-esxi-e34d3152baeb112c9bd77f2381ea0cf9b902613c95d5ae2660b51a4e7ede2785')" = 0:700 ] && [ "$(stat -c %u:%a '/scratch/lober-esxi-e34d3152baeb112c9bd77f2381ea0cf9b902613c95d5ae2660b51a4e7ede2785/stage.sh')" = 0:600 ]; then
   hash=$(sha256sum '/scratch/lober-esxi-e34d3152baeb112c9bd77f2381ea0cf9b902613c95d5ae2660b51a4e7ede2785/stage.sh' 2>/dev/null || :)
   case $hash in 28fb9ff6e4e3f4b43e2e6f765a24769b7086c25c26109c0c815d1e296802ff22\ *) rm -f '/scratch/lober-esxi-e34d3152baeb112c9bd77f2381ea0cf9b902613c95d5ae2660b51a4e7ede2785/stage.sh' || :; rmdir '/scratch/lober-esxi-e34d3152baeb112c9bd77f2381ea0cf9b902613c95d5ae2660b51a4e7ede2785' 2>/dev/null || :;; esac
  fi
  rm -rf /tmp/lober || :
 fi
}
lober_esxi_abort() {
 code=$1
 trap - HUP INT TERM
 if [ -n "${LOBER_ESXI_CHILD:-}" ]; then
  kill -TERM "-$LOBER_ESXI_CHILD" 2>/dev/null || kill -TERM "$LOBER_ESXI_CHILD" 2>/dev/null || :
  wait "$LOBER_ESXI_CHILD" 2>/dev/null || :
 fi
 lober_esxi_cleanup
 exit "$code"
}
trap 's=$?; if [ "$LOBER_ESXI_DONE" -ne 1 ]; then lober_esxi_cleanup; fi; exit "$s"' EXIT
trap 'lober_esxi_abort 129' HUP
trap 'lober_esxi_abort 130' INT
trap 'lober_esxi_abort 143' TERM
lober_esxi_run() {
 case $1 in
  firstboot) setsid sh -c 'LOBER_ESXI_NATIVE_SCRIPT=$0;LOBER_ESXI_OWNER=lober-esxi-firstboot-task-9;export LOBER_ESXI_NATIVE_SCRIPT LOBER_ESXI_OWNER;(LOBER_OLD_IFS=${IFS-};case ${IFS+x} in x) LOBER_IFS_SET=1;; *) LOBER_IFS_SET=0;; esac;case $- in *f*) LOBER_OLD_GLOB=1;; *) LOBER_OLD_GLOB=0;; esac;IFS=;set -f;LOBER_ESXI_CODE=$(echo  | openssl base64 -d -A)||exit 127;LOBER_ESXI_HASH=$(printf %s $LOBER_ESXI_CODE | sha256sum)||exit 127;case $LOBER_ESXI_HASH in df55f939c8e9e3e73d490459a927c98d9f997d60d7fb63d60f084dcd1ce8aa0f*) :;; *) exit 65;; esac;eval $LOBER_ESXI_CODE)' "$0" & ;;
  cleanup) setsid sh -c 'LOBER_ESXI_NATIVE_SCRIPT=$0;LOBER_ESXI_OWNER=lober-esxi-firstboot-task-9;export LOBER_ESXI_NATIVE_SCRIPT LOBER_ESXI_OWNER;(LOBER_OLD_IFS=${IFS-};case ${IFS+x} in x) LOBER_IFS_SET=1;; *) LOBER_IFS_SET=0;; esac;case $- in *f*) LOBER_OLD_GLOB=1;; *) LOBER_OLD_GLOB=0;; esac;IFS=;set -f;LOBER_ESXI_CODE=$(echo  | openssl base64 -d -A)||exit 127;LOBER_ESXI_HASH=$(printf %s $LOBER_ESXI_CODE | sha256sum)||exit 127;case $LOBER_ESXI_HASH in 08db5093fb6b0baba6e253a99f8c966fda535bb72174a7e8afd299a9fbb4e05a*) :;; *) exit 65;; esac;eval $LOBER_ESXI_CODE)' "$0" & ;;
  slot-4) setsid sh -c 'LOBER_ESXI_NATIVE_SCRIPT=$0;LOBER_ESXI_OWNER=lober-esxi-firstboot-task-9;export LOBER_ESXI_NATIVE_SCRIPT LOBER_ESXI_OWNER;(LOBER_OLD_IFS=${IFS-};case ${IFS+x} in x) LOBER_IFS_SET=1;; *) LOBER_IFS_SET=0;; esac;case $- in *f*) LOBER_OLD_GLOB=1;; *) LOBER_OLD_GLOB=0;; esac;IFS=;set -f;LOBER_ESXI_CODE=$(echo  | openssl base64 -d -A)||exit 127;LOBER_ESXI_HASH=$(printf %s $LOBER_ESXI_CODE | sha256sum)||exit 127;case $LOBER_ESXI_HASH in d5c2c62f1131277c738fa441b597995276150d5826af503767bde053f5c6233c*) :;; *) exit 65;; esac;eval $LOBER_ESXI_CODE)' "$0" & ;;
  *) exit 66;;
 esac
 LOBER_ESXI_CHILD=$!
 if wait "$LOBER_ESXI_CHILD"; then LOBER_ESXI_STATUS=0; else LOBER_ESXI_STATUS=$?; fi
 LOBER_ESXI_CHILD=
 if [ "$LOBER_ESXI_STATUS" -ne 0 ]; then lober_esxi_cleanup; exit "$LOBER_ESXI_STATUS"; fi
 if [ "$1" = cleanup ]; then LOBER_ESXI_DONE=1; fi
}
set -e
lober_esxi_run firstboot
lober_esxi_run slot-4
lober_esxi_run cleanup
