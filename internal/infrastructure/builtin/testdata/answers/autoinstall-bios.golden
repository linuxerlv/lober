#cloud-config
# RAM must exceed the full ISO size plus installer working memory: url= downloads the ISO into RAM.
# Layer7 qualification must size the VM from the actual ISO, not a fixed universal minimum.
autoinstall:
  version: 1
  locale: en_US.UTF-8
  keyboard:
    layout: us
  timezone: UTC
  storage:
    layout:
      name: direct
      match:
        path: '/dev/sda'
      ptable: gpt
  network:
    version: 2
    ethernets:
      lober:
        match:
          name: 'eth0'
        dhcp4: true
  identity:
    hostname: 'lober-node'
    username: 'lober'
    password: '$6$fixture$notARealPasswordHash'
  ssh:
    install-server: true
    allow-pw: false
    authorized-keys:
      - 'ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA fixture'
  packages:
    - curl
    - systemd
    - openssh-server
    - 'curl'
    - 'vim'
  late-commands:
    - echo  | base64 -d | sh
    - echo  | base64 -d | sh
