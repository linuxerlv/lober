@echo off
setlocal DisableDelayedExpansion
set "ERRORLEVEL="
set "LOBER_DIR=%SystemDrive%/ProgramData/lober"
del /q "%LOBER_DIR%/runtime-3.rc" >nul 2>nul
if exist "%LOBER_DIR%/runtime-3.rc" exit /b 125
cmd /d /c exit 0
> "%LOBER_DIR%/runtime-3.b64" echo 
if errorlevel 1 exit /b %errorlevel%
>> "%LOBER_DIR%/runtime-3.b64" echo 
if errorlevel 1 exit /b %errorlevel%
>> "%LOBER_DIR%/runtime-3.b64" echo 
if errorlevel 1 exit /b %errorlevel%
"%LOBER_DIR%/busybox.exe" base64 -d "%LOBER_DIR%/runtime-3.b64" > "%LOBER_DIR%/runtime-3.sh"
if errorlevel 1 exit /b %errorlevel%
"%LOBER_DIR%/busybox.exe" sh -X "%LOBER_DIR%/runtime-3.sh"
set "RC=%errorlevel%"
if "%RC%"=="0" if exist "%LOBER_DIR%/runtime-3.rc" set /p "RC="<"%LOBER_DIR%/runtime-3.rc"
del /q "%LOBER_DIR%/runtime-3.b64" "%LOBER_DIR%/runtime-3.sh" "%LOBER_DIR%/runtime-3.rc" >nul 2>nul
endlocal & exit /b %RC%
