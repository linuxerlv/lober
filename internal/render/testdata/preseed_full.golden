d-i	localechooser/languagelist	select	en_US.UTF-8
d-i	keyboard-configuration/xkb-keymap	select	us
d-i	clock-setup/utc	boolean	true
d-i	time/zone	string	UTC
d-i	netcfg/choose_interface	select	auto
d-i	netcfg/get_hostname	string	web-01
d-i	netcfg/get_domain	string	unassigned-domain
d-i	mirror/country	string	manual
d-i	mirror/http/hostname	string	ng.internal
d-i	mirror/http/directory	string	/artifacts/as-debian12/repo/
d-i	mirror/http/proxy	string	
d-i	partman-auto/disk	string	/dev/disk/by-id/wwn-0x5000c500fixed0001
d-i	partman-auto/method	string	regular
d-i	partman-auto/choose_recipe	select	atomic
d-i	partman-partitioning/confirm_write_new_label	boolean	true
d-i	partman/choose_partition	select	finish
d-i	partman/confirm	boolean	true
d-i	partman/confirm_nooverwrite	boolean	true
d-i	passwd/root-login	boolean	false
d-i	passwd/make-user	boolean	false
tasksel	tasksel/first	multiselect	standard
popularity-contest	popularity-contest/participate	boolean	false
d-i	preseed/early_command	string	LOBER_CONTRACT_VERSION=''; LOBER_TASK_ID='42'; LOBER_SN='SN-FIXED-0001'; LOBER_MAC=''; LOBER_UUID=''; LOBER_HOSTNAME='web-01'; LOBER_OS_FAMILY='debian'; LOBER_OS_VERSION=''; LOBER_ARCH=''; LOBER_DISKS=''; LOBER_DISK_PRIMARY='/dev/disk/by-id/wwn-0x5000c500fixed0001'; LOBER_NICS=''; LOBER_RAM_MB=''; LOBER_CPU_CORES=''; LOBER_VENDOR=''; LOBER_PRODUCT=''; LOBER_BIZ_IP='10.20.0.15'; LOBER_BIZ_GW=''; LOBER_BIZ_MASK=''; LOBER_ARTIFACT_BASE='http://ng.internal/artifacts'; LOBER_GATEWAY_BASE='http://gw.internal'; LOBER_RACK=''; LOBER_ROW=''; LOBER_DC=''; GW='http://gw.internal'; ART='http://ng.internal/artifacts'; TASK='42'; TOKEN='install-tok-fixed-0000000000000000'; SEQ=0; ; signal() {;   local phase="$1" rc="${2:-0}" log="${3:-/dev/null}" digest="${4:-}";   SEQ=$((SEQ+1));   local q="$GW/v1/signal/$TASK/$TOKEN/$phase?rc=$rc&seq=$SEQ";   if [ -n "$digest" ]; then;     q="$q&digest=$digest";   fi;   for i in 1 2 3; do;     curl -fsS -m 10 -X POST "$q" \;       -H 'Content-Type: text/plain' --data-binary "@$log" && return 0;     sleep $((i*3));   done;   logger -t lober "signal failed: $phase rc=$rc";   return 0; }; ; run_hook() {;   local digest="$1" required="$2" timeout_sec="$3";   curl -fsS -o /tmp/h.sh "$ART/hooks/$digest/script.sh" || return 1;   echo "$digest  /tmp/h.sh" | sha256sum -c - || return 1;   ( set -euo pipefail; timeout "$timeout_sec" bash /tmp/h.sh ) 2>&1 | tee /tmp/h.log;   local rc=${PIPESTATUS[0]};   signal "hook-report" "$rc" /tmp/h.log "$digest";   [ "$rc" -eq 0 ] || [ "$required" != "true" ]; }; signal "pre-start" 0; run_hook 'aaaa1111pre' 'true' '300' || exit 1; signal "pre-done" 0;
d-i	preseed/late_command	string	in-target sh -c 'echo  | base64 -d > /tmp/lober-late.sh && chmod 755 /tmp/lober-late.sh && /tmp/lober-late.sh'
