LOBER_VENDOR=''
LOBER_PRODUCT=''
LOBER_BIZ_IP=''
LOBER_BIZ_GW=''
LOBER_BIZ_MASK=''
LOBER_ARTIFACT_BASE=''
LOBER_GATEWAY_BASE=''
LOBER_RACK=''
LOBER_ROW=''
LOBER_DC=''
GW='http://gw.internal'
ART='http://ng.internal/artifacts'
