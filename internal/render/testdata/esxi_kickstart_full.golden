install --firstdisk=/dev/disks/t10.NVMe_fixed0001 --overwritevmfs
rootpw --lock
network --bootproto=dhcp
reboot
# syslog 转发通过 esxcli 配置（见 %firstboot 段落），ESXi kickstart 语法没有 RHEL 那一行 logging 指令
# esxcli system syslog config set --loghost=10.10.0.1:514
%pre --interpreter=busybox
LOBER_CONTRACT_VERSION=''
LOBER_TASK_ID='42'
LOBER_SN='SN-ESXI-0001'
LOBER_MAC=''
LOBER_UUID=''
LOBER_HOSTNAME='esxi-01'
LOBER_OS_FAMILY='esxi'
LOBER_OS_VERSION=''
LOBER_ARCH=''
LOBER_DISKS=''
LOBER_DISK_PRIMARY='/dev/disks/t10.NVMe_fixed0001'
LOBER_NICS=''
LOBER_RAM_MB=''
LOBER_CPU_CORES=''
LOBER_VENDOR=''
LOBER_PRODUCT=''
LOBER_BIZ_IP=''
LOBER_BIZ_GW=''
LOBER_BIZ_MASK=''
LOBER_ARTIFACT_BASE=''
LOBER_GATEWAY_BASE=''
LOBER_RACK=''
LOBER_ROW=''
LOBER_DC=''
GW='http://gw.internal'
ART='http://ng.internal/artifacts'
TASK='42'
TOKEN='install-tok-esxi-fixed'
SEQ=0

signal() {
  _lc_phase="$1"
  _lc_rc="${2:-0}"
  _lc_log="${3:-/dev/null}"
  _lc_digest="${4:-}"
  SEQ=$((SEQ+1))
  _lc_q="$GW/v1/signal/$TASK/$TOKEN/$_lc_phase?rc=$_lc_rc&seq=$SEQ"
  if [ -n "$_lc_digest" ]; then
    _lc_q="$_lc_q&digest=$_lc_digest"
  fi
  _lc_i=1
  while [ "$_lc_i" -le 3 ]; do
    curl -fsS -m 10 -X POST "$_lc_q" \
      -H 'Content-Type: text/plain' --data-binary "@$_lc_log" && return 0
    sleep $((_lc_i*3))
    _lc_i=$((_lc_i+1))
  done
  echo "$(date) signal failed: $_lc_phase rc=$_lc_rc" >> /var/log/lober-signal-fail.log
  return 0
}

run_hook() {
  _lc_digest="$1"
  _lc_required="$2"
  _lc_timeout="$3"
  curl -fsS -o /tmp/h.sh "$ART/hooks/$_lc_digest/script.sh" || return 1
  echo "$_lc_digest  /tmp/h.sh" | sha256sum -c - || return 1
  timeout "$_lc_timeout" /bin/sh /tmp/h.sh > /tmp/h.log 2>&1
  _lc_rc=$?
  signal "hook-report" "$_lc_rc" /tmp/h.log "$_lc_digest"
  [ "$_lc_rc" -eq 0 ] || [ "$_lc_required" != "true" ]
}
run_hook 'aaaa1111pre' 'true' '300' || exit 1
%end
%post --interpreter=busybox
LOBER_CONTRACT_VERSION=''
LOBER_TASK_ID='42'
LOBER_SN='SN-ESXI-0001'
LOBER_MAC=''
LOBER_UUID=''
LOBER_HOSTNAME='esxi-01'
LOBER_OS_FAMILY='esxi'
LOBER_OS_VERSION=''
