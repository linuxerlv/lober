#cloud-config
autoinstall:
  version: 1
  locale: en_US.UTF-8
  keyboard:
    layout: us
  identity:
    hostname: web-01
    username: lober
    password: '!'
  storage:
    config:
      - {id: disk0, type: disk, path: /dev/sda, ptable: gpt, wipe: superblock-recursive}
      - {id: esp, type: partition, device: disk0, size: 600M, flag: boot, grub_device: true}
      - {id: esp-fs, type: format, volume: esp, fstype: fat32}
      - {id: esp-mount, type: mount, device: esp-fs, path: /boot/efi}
      - {id: root, type: partition, device: disk0, size: -1}
      - {id: root-fs, type: format, volume: root, fstype: ext4}
      - {id: root-mount, type: mount, device: root-fs, path: /}
  network:
    version: 2
    ethernets:
      install-nic:
        match:
          name: en*
        dhcp4: true
  early-commands:
    - echo c2V0IC1ldQp1bWFzayAwNzcKbWtkaXIgLXAgJy90bXAnCmN1cmwgLWZzUyAtLXJldHJ5IDMgLW8gJy90bXAvc2NyaXB0LTIuc2gnICdodHRwOi8vZ3cuaW50ZXJuYWwvdjEvYW5zd2VyL3Rhc2stNDIvaW5zdGFsbC10b2stZml4ZWQvc2NyaXB0cy8yLnNoJwpzaCAnL3RtcC9zY3JpcHQtMi5zaCcK | base64 -d | sh
  late-commands:
    - echo c2V0IC1ldQp1bWFzayAwNzcKbWtkaXIgLXAgJy90bXAnCmN1cmwgLWZzUyAtLXJldHJ5IDMgLW8gJy90bXAvc2NyaXB0LTMuc2gnICdodHRwOi8vZ3cuaW50ZXJuYWwvdjEvYW5zd2VyL3Rhc2stNDIvaW5zdGFsbC10b2stZml4ZWQvc2NyaXB0cy8zLnNoJwpzaCAnL3RtcC9zY3JpcHQtMy5zaCcK | base64 -d | sh
    - echo  | base64 -d | sh
    - echo c2V0IC1ldQp1bWFzayAwNzcKbWtkaXIgLXAgJy90YXJnZXQvdmFyL2xpYi9sb2JlcicKY3VybCAtZnNTIC0tcmV0cnkgMyAtbyAnL3RhcmdldC92YXIvbGliL2xvYmVyL3NjcmlwdC01LnNoJyAnaHR0cDovL2d3LmludGVybmFsL3YxL2Fuc3dlci90YXNrLTQyL2luc3RhbGwtdG9rLWZpeGVkL3NjcmlwdHMvNS5zaCcK | base64 -d | sh
    - echo  | base64 -d | sh
    - echo  | base64 -d | sh
  packages:
    - curl
  ssh:
    install-server: true
  shutdown: reboot
