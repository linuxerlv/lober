@echo off
setlocal DisableDelayedExpansion
set "ERRORLEVEL="
wpeinit
if errorlevel 1 exit /b %errorlevel%
mkdir X:\lober
copy /y "%SystemRoot%\System32\busybox.exe" X:\lober\busybox.exe >nul
if errorlevel 1 exit /b %errorlevel%
copy /y "%SystemRoot%\System32\curl.exe" X:\lober\curl.exe >nul
if errorlevel 1 exit /b %errorlevel%
set "LOBER_DIR=X:/lober"
del /q "%LOBER_DIR%/startup.rc" >nul 2>nul
if exist "%LOBER_DIR%/startup.rc" exit /b 125
cmd /d /c exit 0
> "%LOBER_DIR%/startup.b64" echo 
if errorlevel 1 exit /b %errorlevel%
>> "%LOBER_DIR%/startup.b64" echo 
if errorlevel 1 exit /b %errorlevel%
>> "%LOBER_DIR%/startup.b64" echo 
if errorlevel 1 exit /b %errorlevel%
"%LOBER_DIR%/busybox.exe" base64 -d "%LOBER_DIR%/startup.b64" > "%LOBER_DIR%/startup.sh"
if errorlevel 1 exit /b %errorlevel%
"%LOBER_DIR%/busybox.exe" sh -X "%LOBER_DIR%/startup.sh"
set "RC=%errorlevel%"
if "%RC%"=="0" if exist "%LOBER_DIR%/startup.rc" set /p "RC="<"%LOBER_DIR%/startup.rc"
del /q "%LOBER_DIR%/startup.b64" "%LOBER_DIR%/startup.sh" "%LOBER_DIR%/startup.rc" >nul 2>nul
endlocal & exit /b %RC%
