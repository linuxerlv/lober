<?xml version="1.0"?>
<!DOCTYPE profile>
<!-- lober 正文扫描样例：AutoYaST（SLES 15、openSUSE Leap 15） -->
<profile xmlns="http://www.suse.com/1.0/yast2ns" xmlns:config="http://www.suse.com/1.0/configns">
  <networking>
    <dns>
      <hostname>{{param:hostname}}</hostname>
    </dns>
  </networking>
  <add-on>
    <add_on_products config:type="list">
      <listentry>
        <media_url>{{sys:repo}}</media_url>
      </listentry>
    </add_on_products>
  </add-on>
  <partitioning config:type="list">
    {{slot:分区}}
  </partitioning>
  <software>
    <packages config:type="list">
      <package>{{param:pkgs}}</package>
    </packages>
  </software>
  <scripts>
    <pre-scripts config:type="list">
      <script><source>{{slot:装前@pre}}</source></script>
    </pre-scripts>
    <chroot-scripts config:type="list">
      <script><chrooted config:type="boolean">true</chrooted><source>{{slot:装后@post-target}}</source></script>
    </chroot-scripts>
    <init-scripts config:type="list">
      <script><source>{{lober:firstboot}}</source></script>
      <script><source>{{lober:cleanup}}</source></script>
    </init-scripts>
  </scripts>
</profile>
