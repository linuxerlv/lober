{
  product: { id: 'SLES' },
  localization: { language: 'en_US.UTF-8', keyboard: 'us', timezone: 'Etc/UTC' },
  storage: {
    drives: [{
      search: '/dev/sda',
      alias: 'system',
      ptableType: 'gpt',
      partitions: [
        { search: '*', delete: true },
        { generate: 'default' },
      ],
    }],
    boot: { configure: true, device: 'system' },
  },
  hostname: { static: 'lober-node' },
  network: {
    connections: [{ id: 'lober', interface: 'eth0', method4: 'auto' }],
  },
  user: { userName: 'lober', fullName: 'lober', hashedPassword: true, password: '$6$fixture$notARealPasswordHash' },
  software: {
    packages: [
      'curl',
      'systemd',
      'openssh',
      'curl',
      'vim',
    ],
  },
  scripts: {
    post: [{ name: 'lober-stage', chroot: false, content: |||
      #!/bin/sh
      set -eu
      chroot /mnt systemctl enable sshd
      echo  | base64 -d | sh
      echo  | base64 -d | sh
      echo  | base64 -d | sh
    ||| }],
  },
}
