cmdline
lang en_US.UTF-8
keyboard us
timezone UTC
url --url='http://artifacts.example.test/media/repo/'
logging --host=192.0.2.1 --port=514 --level=info
network --bootproto=dhcp --device=link --activate --hostname='lober-node'
rootpw --lock
user --name='lober' --password='$6$fixture$notARealPasswordHash' --iscrypted --groups=wheel
sshkey --username='lober' 'ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA fixture'
zerombr
ignoredisk --only-use='sda'
clearpart --all --initlabel --disklabel=gpt --drives='sda'
%pre --interpreter=/bin/sh --erroronfail
set -eu
if test -d /sys/firmware/efi; then
    printf '%s\n' 'part /boot/efi --fstype=efi --size=600 --ondisk=sda' > /tmp/lober-partition.ks
else
    printf '%s\n' 'part biosboot --fstype=biosboot --size=2 --ondisk=sda' > /tmp/lober-partition.ks
fi
printf '%s\n' 'part /boot --fstype=xfs --size=1024 --ondisk=sda' 'part / --fstype=xfs --size=8192 --grow --ondisk=sda' >> /tmp/lober-partition.ks
%end
%include /tmp/lober-partition.ks
%packages
@core
curl
systemd
openssh-server
curl
vim
%end
services --enabled=sshd
%post --nochroot --interpreter=/bin/sh --erroronfail
set -eu
echo  | base64 -d | sh
echo  | base64 -d | sh
%end
reboot
