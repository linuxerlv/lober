%pre --interpreter=busybox
set -eu
(LOBER_OLD_IFS=${IFS-};case ${IFS+x} in x) LOBER_IFS_SET=1;; *) LOBER_IFS_SET=0;; esac;case $- in *f*) LOBER_OLD_GLOB=1;; *) LOBER_OLD_GLOB=0;; esac;IFS=;set -f;LOBER_ESXI_CODE=$(echo  | openssl base64 -d -A)||exit 127;LOBER_ESXI_HASH=$(printf %s $LOBER_ESXI_CODE | sha256sum)||exit 127;case $LOBER_ESXI_HASH in abd600fad38fc1815a11d5c7336f891cb431349ae20103170f44bbbf880116e3*) :;; *) exit 65;; esac;eval $LOBER_ESXI_CODE)
%pre --interpreter=busybox
set -eu
umask 077
D='/tmp/lober-esxi-73475cb40a568e8da8a045ced110137e159f890ac4da883b6b17dc651b3a8049'
[ ! -e "$D" ] && [ ! -L "$D" ] || exit 66
mkdir -m 700 "$D"
trap 's=$?; if [ "$s" -ne 0 ]; then rm -f "$D/stage.sh"; rmdir "$D" 2>/dev/null || :; fi' EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM
timeout -t 30 wget -q -O "$D/stage.sh" 'http://gw.internal/v1/answer/42/install-tok-fixed-0000000000000000/esxi-firstboot.sh'
LOBER_HASH=$(sha256sum "$D/stage.sh") || exit 127
case $LOBER_HASH in f75ebc24740818c370a419025186b4de411b58fa697bd50df78cf2e627902c93\ *) :;; *) exit 65;; esac
trap - EXIT HUP INT TERM
%post --interpreter=busybox
set -eu
umask 077
D='/tmp/lober-esxi-73475cb40a568e8da8a045ced110137e159f890ac4da883b6b17dc651b3a8049'
[ -d "$D" ] && [ ! -L "$D" ] && [ -f "$D/stage.sh" ] && [ ! -L "$D/stage.sh" ] || exit 66
[ "$(stat -c %u:%a "$D")" = 0:700 ] && [ "$(stat -c %u:%a "$D/stage.sh")" = 0:600 ] || exit 66
TARGET=
CREATED=0
trap 's=$?; if [ "$s" -ne 0 ]; then if [ "$CREATED" -eq 1 ]; then rm -f "$TARGET/stage.sh" || :; rmdir "$TARGET" 2>/dev/null || :; fi; rm -f "$D/stage.sh" || :; rmdir "$D" 2>/dev/null || :; fi' EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM
LOBER_DEVICES=$(localcli storage core device list) || exit 66
LOBER_DISKS=$(printf '%s\n' "$LOBER_DEVICES" | awk '/^[[:space:]]*Device Type:[[:space:]]*Direct-Access[[:space:]]*$/ { n++ } END { print n+0 }') || exit 66
[ "$LOBER_DISKS" -eq 1 ] || exit 66
COUNT=0
VOLUME=
for CANDIDATE in /vmfs/volumes/OSDATA-*; do
 [ -d "$CANDIDATE" ] || continue
 COUNT=$((COUNT + 1))
 VOLUME=$CANDIDATE
done
[ "$COUNT" -eq 1 ] && [ "$(stat -f -c %T "$VOLUME")" = vmfs6l ] || exit 66
TARGET="$VOLUME/lober-esxi-73475cb40a568e8da8a045ced110137e159f890ac4da883b6b17dc651b3a8049"
[ ! -e "$TARGET" ] && [ ! -L "$TARGET" ] || exit 66
mkdir -m 700 "$TARGET"
CREATED=1
cp "$D/stage.sh" "$TARGET/stage.sh"
chmod 600 "$TARGET/stage.sh"
LOBER_HASH=$(sha256sum "$TARGET/stage.sh") || exit 127
case $LOBER_HASH in f75ebc24740818c370a419025186b4de411b58fa697bd50df78cf2e627902c93\ *) :;; *) exit 65;; esac
rm -f "$D/stage.sh"
rmdir "$D"
trap - EXIT HUP INT TERM
%firstboot --interpreter=busybox
LOBER_ESXI_RUN_ID=$$
export LOBER_ESXI_RUN_ID
LOBER_ESXI_CHILD=
LOBER_ESXI_DONE=0
lober_esxi_cleanup() {
 if [ -d /tmp/lober ] && [ ! -L /tmp/lober ] && [ "$(stat -c %u:%a /tmp/lober)" = 0:700 ] && [ -f /tmp/lober/.owner ] && [ ! -L /tmp/lober/.owner ] && [ "$(cat /tmp/lober/.owner)" = 'lober-esxi-firstboot-42'":$LOBER_ESXI_RUN_ID" ]; then
  if [ ! -L '/scratch/lober-esxi-73475cb40a568e8da8a045ced110137e159f890ac4da883b6b17dc651b3a8049' ] && [ -f '/scratch/lober-esxi-73475cb40a568e8da8a045ced110137e159f890ac4da883b6b17dc651b3a8049/stage.sh' ] && [ ! -L '/scratch/lober-esxi-73475cb40a568e8da8a045ced110137e159f890ac4da883b6b17dc651b3a8049/stage.sh' ] && [ "$(stat -f -c %T /scratch)" = vmfs6l ] && [ "$(stat -c %u:%a '/scratch/lober-esxi-73475cb40a568e8da8a045ced110137e159f890ac4da883b6b17dc651b3a8049')" = 0:700 ] && [ "$(stat -c %u:%a '/scratch/lober-esxi-73475cb40a568e8da8a045ced110137e159f890ac4da883b6b17dc651b3a8049/stage.sh')" = 0:600 ]; then
   hash=$(sha256sum '/scratch/lober-esxi-73475cb40a568e8da8a045ced110137e159f890ac4da883b6b17dc651b3a8049/stage.sh' 2>/dev/null || :)
   case $hash in f75ebc24740818c370a419025186b4de411b58fa697bd50df78cf2e627902c93\ *) rm -f '/scratch/lober-esxi-73475cb40a568e8da8a045ced110137e159f890ac4da883b6b17dc651b3a8049/stage.sh' || :; rmdir '/scratch/lober-esxi-73475cb40a568e8da8a045ced110137e159f890ac4da883b6b17dc651b3a8049' 2>/dev/null || :;; esac
  fi
  rm -rf /tmp/lober || :
 fi
}
lober_esxi_abort() {
 code=$1
 trap - HUP INT TERM
 if [ -n "${LOBER_ESXI_CHILD:-}" ]; then
  kill -TERM "-$LOBER_ESXI_CHILD" 2>/dev/null || kill -TERM "$LOBER_ESXI_CHILD" 2>/dev/null || :
  wait "$LOBER_ESXI_CHILD" 2>/dev/null || :
 fi
 lober_esxi_cleanup
 exit "$code"
}
trap 's=$?; if [ "$LOBER_ESXI_DONE" -ne 1 ]; then lober_esxi_cleanup; fi; exit "$s"' EXIT
trap 'lober_esxi_abort 129' HUP
trap 'lober_esxi_abort 130' INT
trap 'lober_esxi_abort 143' TERM
lober_esxi_run() {
 case $1 in
  firstboot) setsid sh -c 'LOBER_ESXI_NATIVE_SCRIPT=$0;LOBER_ESXI_OWNER=lober-esxi-firstboot-42;export LOBER_ESXI_NATIVE_SCRIPT LOBER_ESXI_OWNER;(LOBER_OLD_IFS=${IFS-};case ${IFS+x} in x) LOBER_IFS_SET=1;; *) LOBER_IFS_SET=0;; esac;case $- in *f*) LOBER_OLD_GLOB=1;; *) LOBER_OLD_GLOB=0;; esac;IFS=;set -f;LOBER_ESXI_CODE=$(echo  | openssl base64 -d -A)||exit 127;LOBER_ESXI_HASH=$(printf %s $LOBER_ESXI_CODE | sha256sum)||exit 127;case $LOBER_ESXI_HASH in 533a5c48ed985d80964dbd2d9b274d6884865720402b9caa1910fdcb3da1d634*) :;; *) exit 65;; esac;eval $LOBER_ESXI_CODE)' "$0" & ;;
  cleanup) setsid sh -c 'LOBER_ESXI_NATIVE_SCRIPT=$0;LOBER_ESXI_OWNER=lober-esxi-firstboot-42;export LOBER_ESXI_NATIVE_SCRIPT LOBER_ESXI_OWNER;(LOBER_OLD_IFS=${IFS-};case ${IFS+x} in x) LOBER_IFS_SET=1;; *) LOBER_IFS_SET=0;; esac;case $- in *f*) LOBER_OLD_GLOB=1;; *) LOBER_OLD_GLOB=0;; esac;IFS=;set -f;LOBER_ESXI_CODE=$(echo  | openssl base64 -d -A)||exit 127;LOBER_ESXI_HASH=$(printf %s $LOBER_ESXI_CODE | sha256sum)||exit 127;case $LOBER_ESXI_HASH in 99544f18fc9f215218b3238d42741f1e8c6054aeac808a39a722322b2e56b66e*) :;; *) exit 65;; esac;eval $LOBER_ESXI_CODE)' "$0" & ;;
  slot-3) setsid sh -c 'LOBER_ESXI_NATIVE_SCRIPT=$0;LOBER_ESXI_OWNER=lober-esxi-firstboot-42;export LOBER_ESXI_NATIVE_SCRIPT LOBER_ESXI_OWNER;(LOBER_OLD_IFS=${IFS-};case ${IFS+x} in x) LOBER_IFS_SET=1;; *) LOBER_IFS_SET=0;; esac;case $- in *f*) LOBER_OLD_GLOB=1;; *) LOBER_OLD_GLOB=0;; esac;IFS=;set -f;LOBER_ESXI_CODE=$(echo  | openssl base64 -d -A)||exit 127;LOBER_ESXI_HASH=$(printf %s $LOBER_ESXI_CODE | sha256sum)||exit 127;case $LOBER_ESXI_HASH in 84893c8ef1afa39904964bbf259c7a9ec38978c8370089a737420ae9f6543c6e*) :;; *) exit 65;; esac;eval $LOBER_ESXI_CODE)' "$0" & ;;
  *) exit 66;;
 esac
 LOBER_ESXI_CHILD=$!
 if wait "$LOBER_ESXI_CHILD"; then LOBER_ESXI_STATUS=0; else LOBER_ESXI_STATUS=$?; fi
 LOBER_ESXI_CHILD=
 if [ "$LOBER_ESXI_STATUS" -ne 0 ]; then lober_esxi_cleanup; exit "$LOBER_ESXI_STATUS"; fi
 if [ "$1" = cleanup ]; then LOBER_ESXI_DONE=1; fi
}
set -eu
lober_esxi_run firstboot
lober_esxi_run slot-3
lober_esxi_run cleanup
