rootpw --iscrypted $6$loberfixture$s48HMcReZuTl/hNjsbSzMJwS02PdRGxg.c4S/fcvnK13iqHyU.awFlFtXuNgMr03IcKPWRhuoIqMge0LZ.KGX0
