cmdline
url --url=http://ng.internal/artifacts/fixture/repo
lang en_US.UTF-8
keyboard us
timezone UTC --utc
bootloader --location=mbr
network --bootproto=dhcp --activate --hostname=web-01
rootpw --lock
logging --host=10.10.0.1 --port=514
%packages
@core
curl
%end
%pre --erroronfail
set -eu
echo c2V0IC1ldQp1bWFzayAwNzcKbWtkaXIgLXAgJy90bXAnCmN1cmwgLWZzUyAtLXJldHJ5IDMgLW8gJy90bXAvc2NyaXB0LTIuc2gnICdodHRwOi8vZ3cuaW50ZXJuYWwvdjEvYW5zd2VyL3Rhc2stNDIvaW5zdGFsbC10b2stZml4ZWQvc2NyaXB0cy8yLnNoJwpzaCAnL3RtcC9zY3JpcHQtMi5zaCcK | /usr/libexec/platform-python -m base64 -d | sh
cat > /tmp/lober-partition.ks <<'LOBER_PARTITION_EOF'
zerombr
clearpart --all --initlabel --disklabel=gpt --drives=sda
part /boot/efi --fstype=efi --size=600 --ondisk=sda
part / --fstype=xfs --grow --ondisk=sda
LOBER_PARTITION_EOF
%end
%include /tmp/lober-partition.ks
%post --nochroot --erroronfail
set -eu
echo c2V0IC1ldQp1bWFzayAwNzcKbWtkaXIgLXAgJy90bXAnCmN1cmwgLWZzUyAtLXJldHJ5IDMgLW8gJy90bXAvc2NyaXB0LTMuc2gnICdodHRwOi8vZ3cuaW50ZXJuYWwvdjEvYW5zd2VyL3Rhc2stNDIvaW5zdGFsbC10b2stZml4ZWQvc2NyaXB0cy8zLnNoJwpzaCAnL3RtcC9zY3JpcHQtMy5zaCcK | /usr/libexec/platform-python -m base64 -d | sh
echo  | /usr/libexec/platform-python -m base64 -d | sh
echo c2V0IC1ldQp1bWFzayAwNzcKbWtkaXIgLXAgJy9tbnQvc3lzcm9vdC92YXIvbGliL2xvYmVyJwpjdXJsIC1mc1MgLS1yZXRyeSAzIC1vICcvbW50L3N5c3Jvb3QvdmFyL2xpYi9sb2Jlci9zY3JpcHQtNS5zaCcgJ2h0dHA6Ly9ndy5pbnRlcm5hbC92MS9hbnN3ZXIvdGFzay00Mi9pbnN0YWxsLXRvay1maXhlZC9zY3JpcHRzLzUuc2gnCg== | /usr/libexec/platform-python -m base64 -d | sh
echo  | /usr/libexec/platform-python -m base64 -d | sh
echo  | /usr/libexec/platform-python -m base64 -d | sh
%end
reboot
