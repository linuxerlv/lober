#!/bin/sh
set -u
umask 077
DIR=/var/lib/lober
for tool in sha256sum sleep mktemp tail cat base64; do command -v "$tool" >/dev/null 2>&1 || exit 127; done
mkdir -p "$DIR" || exit $?
TOKEN='install-tok-fixed-0000000000000000'
WORK=$(mktemp -d "$DIR/run-3.XXXXXX") || exit $?
trap 'rm -rf "$WORK"' EXIT
OUTBOX_NAME=outbox-install
flush_signals() {
 LOBER_TOKEN='install-tok-fixed-0000000000000000'
 for q_meta in "$DIR/$OUTBOX_NAME/"*.meta; do
  [ -f "$q_meta" ] || continue
  q_path=$(cat "$q_meta") || continue
  q_file=${q_meta%.meta}
  q_address='http://gw.internal/v1/signal/42/'"$LOBER_TOKEN"'/'"$q_path"
  if curl -fsS -m 3 -X POST -H 'Content-Type: text/plain' "$q_address" --data-binary "@$q_file.body" >/dev/null 2>&1; then
   rm -f "$q_meta" "$q_file.body"
  else
   return 1
  fi
 done
 return 0
}
queue_signal() {
 q_label=$1; q_request=$2; q_body=$3
 mkdir -p "$DIR/$OUTBOX_NAME" || return 1
 q_entry="$DIR/$OUTBOX_NAME/$q_label"
 if [ ! -f "$q_entry.meta" ]; then
  if [ -n "$q_body" ]; then cp "$q_body" "$q_entry.body.tmp.$$" || return 1; else : > "$q_entry.body.tmp.$$" || return 1; fi
  mv "$q_entry.body.tmp.$$" "$q_entry.body" || return 1
  printf '%s\n' "$q_request" > "$q_entry.meta.tmp.$$" || return 1
  mv "$q_entry.meta.tmp.$$" "$q_entry.meta" || return 1
 fi
 flush_signals || :
}
signal() {
 phase=$1; instance=$2; rc=$3; digest=$4; body=$5
 label_instance=$instance; label_step=0
 case "$phase" in hook-report) label_step=1;; slot-end) label_instance=999999999; label_step=9;; esac
 label=$(printf '1-%09d-%09d-%d' 3 "$label_instance" "$label_step")
 request="$phase?slot=3&timing=pre&rc=$rc"
 if [ "$instance" -ne 0 ]; then request="$request&instance=$instance&digest=$digest"; fi
 queue_signal "$label" "$request" "$body"
}
kill_tree() {
 children=$(cat "/proc/$1/task/$1/children" 2>/dev/null) || children=
 for child in $children; do kill_tree "$child"; done
 kill -KILL "$1" 2>/dev/null || :
}
run_bounded() {
 seconds=$1; shift
 "$@" &
 process=$!
 (sleep "$seconds" || exit 0; : > "$WORK/timed-out"; kill_tree "$process") >/dev/null 2>&1 &
 watchdog=$!
 if wait "$process"; then status=0; else status=$?; fi
 kill_tree "$watchdog"
 wait "$watchdog" 2>/dev/null || :
 if [ -f "$WORK/timed-out" ]; then status=124; fi
 rm -f "$WORK/timed-out"
 return "$status"
}
signal slot-start 0 0 '' ''
HOOK="$DIR/hook-9d08d2a923b2a2b13e00ba206fafa9a912a68f0c7478302bded683ae9992656f.sh"
LOG="$WORK/hook-1.log"
: > "$LOG"
RC=0
signal hook-start 1 0 '9d08d2a923b2a2b13e00ba206fafa9a912a68f0c7478302bded683ae9992656f' ''
if curl -fsS --retry 3 -o "$HOOK" 'http://gw.internal/v1/answer/42/install-tok-fixed-0000000000000000/hooks/9d08d2a923b2a2b13e00ba206fafa9a912a68f0c7478302bded683ae9992656f' >"$LOG" 2>&1; then :; else RC=$?; fi
if [ "$RC" -eq 0 ]; then
 HASH=$(sha256sum "$HOOK" 2>>"$LOG") || HASH=
 HASH=${HASH%% *}
 if [ "$HASH" != '9d08d2a923b2a2b13e00ba206fafa9a912a68f0c7478302bded683ae9992656f' ]; then RC=65; printf '%s\n' 'hook digest mismatch' >>"$LOG"; fi
fi
printf '%s' 'IyEvYmluL3NoCmV4ZWMgc2ggIiRIT09LIgo=' | base64 -d > "$WORK/launch-1.sh" || exit $?
export HOOK
if [ "$RC" -eq 0 ]; then
 if run_bounded 3 sh "$WORK/launch-1.sh" >>"$LOG" 2>&1; then RC=0; else RC=$?; fi
fi
tail -c 4096 "$LOG" > "$WORK/tail"
signal hook-report 1 "$RC" '9d08d2a923b2a2b13e00ba206fafa9a912a68f0c7478302bded683ae9992656f' "$WORK/tail"
if [ "$RC" -ne 0 ]; then signal slot-end 0 "$RC" '' ''; exit "$RC"; fi
signal slot-end 0 0 '' ''
exit 0
