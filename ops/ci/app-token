#!/usr/bin/python3 -I
"""向 GitHub 换取短期安装令牌。"""

import base64
import json
import os
import subprocess
import sys
import time
import urllib.request


def encode(data):
    return base64.urlsafe_b64encode(data).rstrip(b"=").decode("ascii")


class RejectRedirect(urllib.request.HTTPRedirectHandler):
    def redirect_request(self, req, fp, code, msg, headers, newurl):
        return None


def issue_token(app_id, installation_id, key, repository):
    now = int(time.time())
    claims = {"iat": now - 60, "exp": now + 540, "iss": app_id}
    header = encode(b'{"alg":"RS256","typ":"JWT"}')
    unsigned = f"{header}.{encode(json.dumps(claims).encode('ascii'))}"
    signature = subprocess.run(
        ["/usr/bin/openssl", "dgst", "-sha256", "-sign", key],
        input=unsigned.encode("ascii"), capture_output=True, check=True, timeout=5,
    ).stdout
    permissions = {"contents": "read", "pull_requests": "read", "statuses": "write"}
    payload = {"repositories": [repository], "permissions": permissions}
    request = urllib.request.Request(
        f"https://api.github.com/app/installations/{installation_id}/access_tokens",
        data=json.dumps(payload).encode("ascii"), method="POST",
        headers={"Authorization": f"Bearer {unsigned}.{encode(signature)}",
                 "Accept": "application/vnd.github+json",
                 "Content-Type": "application/json",
                 "X-GitHub-Api-Version": "2026-03-10"},
    )
    opener = urllib.request.build_opener(RejectRedirect())
    with opener.open(request, timeout=15) as response:
        return json.load(response)["token"]


def main():
    try:
        key = os.environ["LOBER_CI_APP_KEY"]
        if not os.path.isabs(key):
            raise ValueError("key path must be absolute")
        token = issue_token(int(os.environ["LOBER_CI_APP_ID"]),
                            int(os.environ["LOBER_CI_INSTALLATION_ID"]), key,
                            os.environ["LOBER_CI_GITHUB_REPOSITORY"].split("/", 1)[1])
        print(token)
    except (OSError, ValueError, IndexError, KeyError, subprocess.SubprocessError):
        print("无法获取 GitHub 应用安装令牌", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
