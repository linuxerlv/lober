// 部署前必跑的校验命令（本机若有 Kea）：
//   kea-dhcp4 -t deploy/kea/lober-dhcp4.json
// 光跑通配置测试模式不够——务必再验证一台 UEFI 机器不会同时命中两个
// class（本文件用重复反条件规避了这个风险，但该规避是否必要仍待实测，
// 见下方要点 1），并抓一次 DHCP DISCOVER 报文确认固件实际上报的
// option 93 值与本文件判定条件一致。SPEC 附录 A.15 记录过「UEFI 固件
// 明确发 0x0007，Kea 仍回 legacy BIOS 引导文件」的实战踩坑，配置文件
// 里的注释不能代替抓包核实。
//
// 注：Kea 官方 JSON 解析器支持 // 与 /* */ 注释（工程惯例），本文件
// 用它们承载中文说明；如目标 Kea 版本或所用配置管理工具不接受这类
// 注释，部署前需先转成 Kea 原生的 "comment" 元素或整段剔除注释再喂给
// kea-dhcp4 -t。
//
// ⚠ 仅在无法使用 dnsmasq 时才用这份配置。
//   判据：目标机房已有在运的 DHCP 服务（可能就是 Kea 本身）且不接受
//   再引入 dnsmasq。新部署优先选 dnsmasq；若目标环境本就是 Kea 或
//   需要 Kea 的其它特性，本文件是可用的等价配置。完整判据、与
//   dnsmasq/dhcpd 的机制对照表见同目录上级 README-既有DHCP.md。
//
// 依据：
//   SPEC.md §1.3（dnsmasq 基线两阶段逻辑）、§1.3.2（本等价配置）
//   docs/superpowers/plans/2026-09-20-lober-mvp-09-integration.md 任务 7b
//
// ============================================================================
// 占位值说明（务必修改，以下均为示例值，不是可直接部署的真值）：
//   10.10.0.0/24、10.10.0.1、10.10.0.100-200  —— 装机 VLAN 的网段与网关，
//     部署时必须与 deploy/dnsmasq/lober.conf、deploy/nginx/lober.conf 里
//     填入的真实网段一致（dnsmasq 版本里这些是 <PXE_VLAN_...> 占位符，
//     本文件直接借用 SPEC.md §1.3 的示例网段，两者部署时要落到同一个真值）
//   boot.lober.internal                       —— 网关域名示例，dnsmasq 版本
//     里对应的是 <GATEWAY_DOMAIN> 占位符，部署时两处要填同一个真实域名，
//     并在既有 DNS 中登记解析到网关 IP
//   undionly.kpxe / snponlyx32.efi / snponly.efi / snp-arm64.efi
//                                              —— iPXE 二进制文件名，
//     必须与 next-server 指向的 TFTP 服务器上的实际文件名一致
//   subnet4[0].id 的取值 1                     —— 仅需在同一 Kea 实例内
//     唯一，多子网部署时改成不冲突的编号
// ============================================================================
{
"Dhcp4": {
  // client-classes 是 Kea 表达两阶段逻辑的机制，与 dnsmasq 的 tag 集合、
  // dhcpd 的 if/elsif 条件链都不同：这里没有互斥保证，所有 class 各自
  // 独立求值（SPEC §1.3.2）。危险之处——一台 UEFI 机器跑起 iPXE 后
  // 再次发 DISCOVER，此时它同时满足 "ipxe" class（option 77 是 iPXE）
  // 与 "efi64" class（option 93 是 7）两者的 test。若两个 class 都设了
  // boot-file-name，实际生效的是哪个取决于 Kea 的 class 求值与 option
  // 合并顺序——这条语义本设计不依赖（SPEC 附录 B 列为待核实项）。
  "client-classes": [
    {
      "name": "ipxe",
      // option[77] 是 user-class，Kea 用符号名 user-class 或数值
      // option[77] 均可引用。iPXE 发送的是裸字符串 "iPXE"，取前 4
      // 字节比较——DHCPv4 option 77 规范上（RFC 3004）是带长度前缀
      // 的字符串列表，但此处按 iPXE 实际发送的裸字符串处理，具体
      // 字节形态需抓包确认（SPEC 附录 B）。
      "test": "substring(option[user-class].hex, 0, 4) == 'iPXE'",
      "boot-file-name": "http://boot.lober.internal/boot.ipxe"
      // 无需 next-server：boot-file-name 以 http:// 开头时 iPXE 按
      // URI scheme 直接走 HTTP（SPEC 附录 A.13，2-1 弱确认）。
    },
    {
      "name": "bios",
      // option 93 在 Kea 里的标准符号名是 client-system（不是 dhcpd
      // 配置里的自定义名 client-arch）；这里先用数值形式 option[93]
      // 引用——符号名若与目标 Kea 版本对不上会导致 kea-dhcp4 直接
      // 启动失败，比静默不匹配更容易发现，实测确认符号名可用后
      // 可换成 option[client-system].hex。
      //
      // 反条件（not substring(...) == 'iPXE'）在四个架构 class 里
      // 各写一遍而不是只写一次，是本文件唯一的设计取舍：宁可重复
      // 也不省，换来的是配置正确性不依赖 Kea 的 class 求值顺序与
      // option 合并语义。若确认 member() 函数可用且 "ipxe" class
      // 的求值确实先于架构 class 完成（Kea 文档称 class 按配置中
      // 定义的顺序处理，故 "ipxe" 需放在数组首位），可简化为
      // not member('ipxe')——但这条简化必须先用 kea-dhcp4 -t 加
      // 真机验证，不能直接照抄启用（SPEC 附录 B）。
      "test": "option[93].hex == 0x0000 and not (substring(option[user-class].hex, 0, 4) == 'iPXE')",
      "next-server": "10.10.0.1",
      "boot-file-name": "undionly.kpxe"
    },
    {
      "name": "efi32",
      "test": "option[93].hex == 0x0006 and not (substring(option[user-class].hex, 0, 4) == 'iPXE')",
      "next-server": "10.10.0.1",
      "boot-file-name": "snponlyx32.efi"
    },
    {
      "name": "efi64",
      // x64 UEFI —— 7 与 9 必须都匹配，且 7 才是实测主流值。理由与
      // deploy/dnsmasq/lober.conf、deploy/dhcpd/lober.conf 中的同一段
      // 注释一致：RFC 4578 的勘误把 7/9 的定义互换过，只配 9 会让
      // UEFI 机器匹配不上任何 class、拿不到 boot-file-name。SPEC
      // 附录 A.15 记录的实战踩坑正是这个码值——有用户报告 UEFI
      // 固件明确发 0x0007，但 Kea 仍回了 legacy BIOS 的引导文件，
      // 与本节这条错误配置同源。调试第一步永远是抓 DISCOVER 报文
      // 看固件实际上报什么，不要相信配置文件里的注释（包括这一条）。
      "test": "(option[93].hex == 0x0007 or option[93].hex == 0x0009) and not (substring(option[user-class].hex, 0, 4) == 'iPXE')",
      "next-server": "10.10.0.1",
      "boot-file-name": "snponly.efi"
    },
    {
      "name": "arm64",
      // MVP 阶段可以不在 TFTP 根目录放这个二进制，但 class 要留：
      // 留着时缺文件会在 TFTP 日志留下「文件不存在」的记录，比落进
      // 未分类（下方说明）更容易排查。
      "test": "option[93].hex == 0x000b and not (substring(option[user-class].hex, 0, 4) == 'iPXE')",
      "next-server": "10.10.0.1",
      "boot-file-name": "snp-arm64.efi"
    }
    // 未知架构：不会命中以上任何 class，也就拿不到 boot-file-name——
    // 行为与 deploy/dhcpd/lober.conf 的显式 else 分支等效，但 Kea 不会
    // 为此主动留日志。这是 Kea 与 dhcpd 的实质差异之一：dhcpd 的未知
    // 架构分支至少能在日志里留痕，Kea 下「机器毫无反应」这一症状更难
    // 定位。需要日志时靠 Dhcp4.hooks-libraries 挂钩子库，或把
    // Logging.loggers 的 severity 调到 DEBUG 观察未分类的 DISCOVER
    // 报文——本文件不预置钩子库配置，因为具体钩子库路径依赖目标
    // 系统的 Kea 安装方式，留给部署时按 README-既有DHCP.md 补充。
  ],
  "subnet4": [
    {
      // id 只需在同一 Kea 实例内唯一；多子网部署时改成不冲突的编号。
      "id": 1,
      "subnet": "10.10.0.0/24",
      "pools": [ { "pool": "10.10.0.100 - 10.10.0.200" } ],
      "option-data": [
        { "name": "routers", "data": "10.10.0.1" },
        { "name": "domain-name-servers", "data": "10.10.0.1" }
      ]
      // 无需在这里声明 option 93——Kea 内置标准选项定义（RFC 4578
      // client-architecture），这是与 dhcpd 的实质差异：dhcpd 必须先
      // `option client-arch code 93 = unsigned integer 16;` 才能引用，
      // Kea 直接就能在 client-classes 的 test 表达式里写 option[93]。
    }
  ]
}
}
